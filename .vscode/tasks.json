{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Typescript",
            "type": "shell",
            // Assign output file name with VSCode inner variables like ${fileBasename}
            "command": "tsc -p tsconfig.json",
            "options": {
            },
            "problemMatcher": ["$tsc"],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "minify",
            "type": "shell",
            "command": "uglifyjs js/functions.js -o js/functions.js -m --no-annotations",
            "options": {
            },
            "problemMatcher": ["$uglifyjs"],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Build Less",
            "type": "shell",
            // Assign output file name with VSCode inner variables like ${fileBasename}
            "command": "lessc src/style.less style.css",
            "options": {
            },
            "problemMatcher": ["$lessc"],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Build All",
            "dependsOn": ["Build Typescript", "minify", "Build Less"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
    ]
}
