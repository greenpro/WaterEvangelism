{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Typescript",
            "type": "shell",
            // Assign output file name with VSCode inner variables like ${fileBasename}
            "command": "tsc -p tsconfig.json",
            "options": {
            },
            "problemMatcher": ["$tsc"],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "minify js",
            "type": "shell",
            "command": "rm js/*.min.js;for f in js/*.js; do short=${f%.js}; uglifyjs $f -o $short.min.js -m --no-annotations; done",
            "options": {
            },
            "problemMatcher": ["$uglifyjs"],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Build Less",
            "type": "shell",
            // Assign output file name with VSCode inner variables like ${fileBasename}
            "command": "lessc src/style.less css/style.css",
            "options": {
            },
            "problemMatcher": ["$lessc"],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "minify css",
            "type": "shell",
            "command": "rm css/*.min.css;for f in css/*.css; do short=${f%.css}; uglifycss $f --output $short.min.css; done",
            "options": {
            },
            "problemMatcher": ["$uglifyjs"],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Build All",
            "dependsOn": ["Build Typescript", "minify js", "Build Less", "minify css"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
    ]
}
